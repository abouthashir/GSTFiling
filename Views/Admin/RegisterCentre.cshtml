@model GSTFiling.Models.Centre

@{
    Layout = null;
    ViewData["Title"] = "Register New Centre";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register New Centre - GSTIntel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --sage-green: #1B5E20;
            --sage-dark: #0D3B12;
            --sage-light: #EAF5E8;
            --sage-border: #D5E1D8;
            --sage-text: #59665E;
            --white: #FFFFFF;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--sage-light);
            font-family: Arial, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
        }

        .register-card {
            width: 100%;
            max-width: 850px;
            background: var(--white);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(27, 94, 32, 0.12);
            border: 1px solid #DDE7DC;
        }

        .register-header {
            background: var(--sage-green);
            color: var(--white);
            padding: 22px 28px;
        }

        .register-header h4 {
            margin: 0;
            font-weight: 700;
        }

        .register-body {
            padding: 30px;
        }

        .form-label {
            color: var(--sage-text);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .form-control {
            background: #F7F9F7;
            border: 1px solid var(--sage-border);
            border-radius: 7px;
            padding: 12px 14px;
        }

        .form-control:focus {
            background: var(--white);
            border-color: var(--sage-green);
            box-shadow: 0 0 0 3px rgba(27, 94, 32, 0.15);
        }

        .section-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--sage-green);
            margin-bottom: 15px;
        }

        .btn-register {
            background: var(--sage-green);
            color: var(--white);
            border: 1px solid var(--sage-green);
        }

        .btn-register:hover,
        .btn-register:focus {
            background: var(--sage-dark);
            border-color: var(--sage-dark);
            color: var(--white);
        }

        .btn-light {
            background: var(--white);
            color: var(--sage-dark);
        }

        .btn-light:hover {
            background: var(--sage-light);
            color: var(--sage-dark);
        }

        .btn-outline-secondary {
            color: var(--sage-green);
            border-color: var(--sage-border);
        }

        .btn-outline-secondary:hover {
            background: var(--sage-light);
            color: var(--sage-dark);
            border-color: var(--sage-green);
        }

        .text-danger {
            color: #C0392B !important;
        }

        @@media (max-width: 576px) {
            body {
                padding: 12px;
                align-items: flex-start;
            }

            .register-body {
                padding: 20px;
            }

            .register-header {
                padding: 18px 20px;
            }

            .register-header h4 {
                font-size: 19px;
            }
        }
    </style>
</head>

<body>
    <div class="register-card">

        <div class="register-header d-flex justify-content-between align-items-center">
            <h4>Register New Centre</h4>
            <i class="bi bi-building-add fs-3"></i>
        </div>

        <div class="register-body">

            <form method="post" action="/Admin/RegisterCentre">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-4">
                    <label for="Name" class="form-label">Firm / Centre Name</label>
                    <input type="text"
                           id="Name"
                           name="Name"
                           class="form-control"
                           value="@Model?.Name"
                           placeholder="e.g. Creative Tax Solutions"
                           required>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label for="Address" class="form-label">Office Address</label>
                    <textarea id="Address"
                              name="Address"
                              class="form-control"
                              rows="3"
                              placeholder="Full physical address"
                              required>@Model?.Address</textarea>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label for="ContactName" class="form-label">Manager Name</label>
                        <input type="text"
                               id="ContactName"
                               name="ContactName"
                               class="form-control"
                               value="@Model?.ContactName"
                               placeholder="Enter manager name"
                               required>
                        <span asp-validation-for="ContactName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label for="MobileNumber" class="form-label">Mobile</label>
                        <input type="tel"
                               id="MobileNumber"
                               name="MobileNumber"
                               class="form-control"
                               value="@Model?.MobileNumber"
                               placeholder="Enter 10-digit mobile number"
                               pattern="[0-9]{10}"
                               maxlength="10"
                               required>
                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-2 mb-3">
                    <div class="section-title">
                        <i class="bi bi-shield-lock me-2"></i>Login Credentials
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Email" class="form-label">Centre Email</label>
                            <input type="email"
                                   id="Email"
                                   name="Email"
                                   class="form-control"
                                   value="@Model?.Email"
                                   placeholder="Centre Email"
                                   required>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="passwordField" class="form-label">Password</label>

                            <div class="input-group">
                                <input type="password"
                                       id="passwordField"
                                       name="Password"
                                       class="form-control"
                                       placeholder="Enter password (minimum 8 characters)"
                                       minlength="8"
                                       autocomplete="new-password"
                                       required>

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        id="togglePassword"
                                        aria-label="Show or hide password">
                                    <i class="bi bi-eye" id="eyeIcon"></i>
                                </button>
                            </div>

                            <span class="text-muted small">
                                Use at least 8 characters.
                            </span>

                            <span class="text-danger small">
                                @Html.ValidationMessage("Password")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a href="/Admin/Centres"
                       class="btn btn-light border px-4 py-2">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-register px-4 py-2">
                        <i class="bi bi-check-circle me-1"></i>
                        Register Centre
                    </button>
                </div>

            </form>
        </div>
    </div>

    <script>
        document.getElementById("togglePassword").addEventListener("click", function () {
            const password = document.getElementById("passwordField");
            const icon = document.getElementById("eyeIcon");

            if (password.type === "password") {
                password.type = "text";
                icon.className = "bi bi-eye-slash";
            } else {
                password.type = "password";
                icon.className = "bi bi-eye";
            }
        });
    </script>
</body>
</html>