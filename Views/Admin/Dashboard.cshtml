@{
    ViewData["Title"] = " Admin Dashboard";

    var totalCentres = ViewBag.TotalCentres ?? 0;
    var totalShops = ViewBag.TotalShops ?? 0;
    var totalTax = ViewBag.TotalTax ?? 0;

    int selectedYear = ViewBag.SelectedYear != null
        ? Convert.ToInt32(ViewBag.SelectedYear)
        : DateTime.Now.Year;

    int selectedMonth = ViewBag.SelectedMonth != null
        ? Convert.ToInt32(ViewBag.SelectedMonth)
        : DateTime.Now.Month;

    string[] months =
    {
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    };

    if (selectedMonth < 1 || selectedMonth > 12)
    {
        selectedMonth = DateTime.Now.Month;
    }
}

<div class="container-fluid py-4 min-vh-100 dashboard-background">
    <div class="row g-4">

        <!-- LEFT SIDEBAR -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden position-sticky sidebar-card"
                 style="top: 2rem;">

                <div class="p-4 text-center border-bottom border-white border-opacity-10">
                    <div class="mx-auto mb-3 bg-white bg-opacity-20 rounded-circle d-flex align-items-center justify-content-center"
                         style="width:70px;height:70px;">
                        <i class="bi bi-shield-check text-white fs-2"></i>
                    </div>

                    <h5 class="text-white fw-bold mb-0">Admin</h5>

                    <p class="text-white-50 small mb-0 text-uppercase">
                        System Control
                    </p>
                </div>

                <div class="list-group list-group-flush p-3">

                    <a asp-controller="Admin" asp-action="Dashboard"
                       class="list-group-item list-group-item-action active sidebar-link rounded-3 mb-2 py-3 px-4">
                        <i class="bi bi-grid-1x2-fill me-3"></i>
                        Dashboard
                    </a>

                    <a asp-controller="Admin" asp-action="Centres"
                       class="list-group-item list-group-item-action sidebar-link rounded-3 mb-2 py-3 px-4">
                        <i class="bi bi-building-fill me-3"></i>
                        Manage firms
                    </a>

                    <a asp-controller="Admin" asp-action="MasterData"
                       class="list-group-item list-group-item-action sidebar-link rounded-3 mb-2 py-3 px-4">
                        <i class="bi bi-gear-fill me-3"></i>
                        Master Data
                    </a>

                    <hr class="mx-3 my-2 border-white border-opacity-20" />

                    <!-- SIGN OUT -->
                    <form asp-controller="Auth"
                          asp-action="Logout"
                          method="post"
                          class="m-0">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="list-group-item list-group-item-action sidebar-link rounded-3 py-3 px-4 w-100 text-start">
                            <i class="bi bi-box-arrow-left me-3"></i>
                            Sign Out
                        </button>
                    </form>

                </div>
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="col-lg-9 d-flex flex-column gap-4">

            <!-- HEADER -->
            <div class="d-flex flex-column gap-3">

                <div>
                    <h4 class="fw-bold text-success mb-1">
                        Network Analytics
                    </h4>

                    <p class="text-secondary mb-0 small">
                        Overview of GST centres and tax collections.
                    </p>
                </div>

                <!-- LOGOUT ABOVE YEAR AND MONTH DROPDOWNS -->
                <div class="d-flex flex-column align-items-end gap-2">

                    <!-- LOGOUT -->
                    <form asp-controller="Auth"
                          asp-action="Logout"
                          method="post"
                          class="m-0">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger rounded-pill px-4 btn-sm">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout
                        </button>
                    </form>

                    <!-- YEAR AND MONTH FILTERS -->
                    <form id="filterForm"
                          asp-controller="Admin"
                          asp-action="Dashboard"
                          method="get"
                          class="d-flex gap-2 align-items-center flex-wrap justify-content-end">

                        <!-- YEAR DROPDOWN -->
                        <div class="d-flex align-items-center bg-white rounded-pill shadow-sm px-3">

                            <i class="bi bi-calendar-event text-success me-2"></i>

                            <select name="year"
                                    class="form-select border-0 bg-transparent py-2"
                                    style="width:auto;min-width:100px;"
                                    onchange="this.form.submit()">

                                @for (int year = DateTime.Now.Year; year >= 2017; year--)
                                {
                                    if (selectedYear == year)
                                    {
                                        <option value="@year" selected>@year</option>
                                    }
                                    else
                                    {
                                        <option value="@year">@year</option>
                                    }
                                }

                            </select>
                        </div>

                        <!-- MONTH DROPDOWN -->
                        <div class="d-flex align-items-center bg-white rounded-pill shadow-sm px-3">

                            <i class="bi bi-clock-history text-success me-2"></i>

                            <select name="month"
                                    class="form-select border-0 bg-transparent py-2"
                                    style="width:auto;min-width:130px;"
                                    onchange="this.form.submit()">

                                @for (int i = 0; i < months.Length; i++)
                                {
                                    int monthNumber = i + 1;

                                    if (selectedMonth == monthNumber)
                                    {
                                        <option value="@monthNumber" selected>
                                            @months[i]
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@monthNumber">
                                            @months[i]
                                        </option>
                                    }
                                }

                            </select>
                        </div>

                    </form>
                </div>

            </div>

            <!-- STATISTICS CARDS -->
            <div class="row g-4">

                <!-- TOTAL CENTRES -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white hover-lift">

                        <div class="icon-circle bg-success bg-opacity-10 text-success">
                            <i class="bi bi-building fs-2"></i>
                        </div>

                        <h2 class="fw-bold text-dark mb-0">
                            @totalCentres
                        </h2>

                        <p class="text-muted text-uppercase small mb-3 mt-2"
                           style="letter-spacing:1px;">
                            Total Centres
                        </p>

                        <a asp-controller="Admin" asp-action="Centres"
                           class="btn btn-success rounded-pill px-4 btn-sm w-100">
                            <i class="bi bi-diagram-3 me-1"></i>
                            Manage Network
                        </a>

                    </div>
                </div>

                <!-- TAX COLLECTION -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white hover-lift">

                        <div class="icon-circle bg-success bg-opacity-10 text-success">
                            <i class="bi bi-currency-rupee fs-2"></i>
                        </div>

                        <h2 class="fw-bold text-dark mb-0">
                            ₹ @Convert.ToDecimal(totalTax).ToString("N0")
                        </h2>

                        <p class="text-muted text-uppercase small mb-3 mt-2"
                           style="letter-spacing:1px;">
                            Collection (@months[selectedMonth - 1])
                        </p>

                        <button type="button"
                                class="btn btn-outline-success rounded-pill px-4 btn-sm w-100"
                                disabled>
                            Monthly Revenue
                        </button>

                    </div>
                </div>

                <!-- TOTAL CLIENTS -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white hover-lift">

                        <div class="icon-circle bg-success bg-opacity-10 text-success">
                            <i class="bi bi-shop fs-2"></i>
                        </div>

                        <h2 class="fw-bold text-dark mb-0">
                            @totalShops
                        </h2>

                        <p class="text-muted text-uppercase small mb-3 mt-2"
                           style="letter-spacing:1px;">
                            Total Clients
                        </p>

                        <button type="button"
                                class="btn btn-success rounded-pill px-4 btn-sm w-100"
                                disabled>
                            Active Businesses
                        </button>

                    </div>
                </div>

            </div>

            <!-- NO CENTRE ADMINISTRATION CARD HERE -->
            <!-- NO MASTER SETTINGS CARD HERE -->

        </div>
        <!-- END MAIN CONTENT -->

    </div>
</div>

<style>
    .dashboard-background {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    }

    .sidebar-card {
        background: #166534;
    }

    .sidebar-link {
        border: 0 !important;
        color: #ffffff !important;
        background: transparent !important;
        transition: all 0.2s ease;
    }

    .sidebar-link:hover {
        background: rgba(255, 255, 255, 0.12) !important;
        transform: translateX(4px);
    }

    .sidebar-link.active {
        background: #ffffff !important;
        color: #166534 !important;
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .icon-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        margin: 0 auto 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hover-lift {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 1.2rem 2.5rem rgba(22, 101, 52, 0.12) !important;
    }

    .quick-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        background: #f0fdf4;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>