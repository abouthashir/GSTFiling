@model GSTFiling.Models.Centre
@using GSTFiling.Models

@{
    Layout = null;
    ViewData["Title"] = "Centre Details";

    var shops = ViewBag.Shops as IEnumerable<Customer>
        ?? Enumerable.Empty<Customer>();

    var consultants = ViewBag.Consultants as IEnumerable<Consultant>
        ?? Enumerable.Empty<Consultant>();

    var totalShops = shops.Count();
    var totalConsultants = consultants.Count();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Centre Details - GSTIntel</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        :root {
            --sage-green: #1B5E20;
            --sage-dark: #0D3B12;
            --sage-light: #EAF5E8;
            --sage-border: #D5E1D8;
            --text-dark: #263729;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--sage-light);
            color: var(--text-dark);
            font-family: Arial, Helvetica, sans-serif;
        }

        .sidebar {
            background: var(--sage-green);
            color: white;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            margin-bottom: 7px;
            border-radius: 9px;
            color: #ffffff;
            text-decoration: none;
            transition: background 0.2s ease;
        }

        .sidebar-link:hover,
        .sidebar-link.active {
            background: var(--sage-dark);
            color: #ffffff;
        }

        .sage-button {
            background: var(--sage-green);
            color: white;
            transition: background 0.2s ease;
        }

        .sage-button:hover {
            background: var(--sage-dark);
            color: white;
        }

        .sage-heading {
            background: var(--sage-green);
            color: white;
        }

        .sage-text {
            color: var(--sage-dark);
        }

        .sage-soft {
            background: var(--sage-light);
        }

        .info-card {
            border: 1px solid var(--sage-border);
            border-radius: 12px;
            padding: 16px;
            background: #ffffff;
            min-width: 0;
        }

        .table-heading {
            background: var(--sage-light);
            color: var(--sage-dark);
        }

        .data-table th,
        .data-table td {
            padding: 13px 16px;
            text-align: left;
            border-bottom: 1px solid #E5E7EB;
            vertical-align: top;
        }

        .data-table th {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .data-table td {
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .data-table tbody tr:hover {
            background: #F8FBF7;
        }

        .status-active {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 999px;
            background: #EAF5E8;
            color: #1B5E20;
            font-size: 12px;
            font-weight: 700;
        }

        .status-inactive {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 999px;
            background: #FEE2E2;
            color: #991B1B;
            font-size: 12px;
            font-weight: 700;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        @@media (max-width: 1023px) {
            .sidebar {
                width: 100% !important;
                min-height: auto !important;
            }

            .page-layout {
                flex-direction: column;
            }

            .sidebar nav {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 6px;
            }

            .sidebar-link {
                margin-bottom: 0;
                font-size: 13px;
            }

            .main-content {
                padding: 16px !important;
            }
        }
    </style>
</head>

<body>
    <div class="page-layout flex min-h-screen">

        <!-- Sidebar -->
        <aside class="sidebar w-64 min-h-screen flex-shrink-0 p-5 flex flex-col">

            <div class="flex items-center gap-3 mb-9 px-2">
                <div class="w-11 h-11 rounded-xl bg-white flex items-center justify-center">
                    <i class="fa-solid fa-file-invoice-dollar text-2xl"
                       style="color: var(--sage-green);"></i>
                </div>

                <div>
                    <h1 class="text-xl font-bold tracking-wide">GSTIntel</h1>
                    <p class="text-xs text-white/80">Admin Portal</p>
                </div>
            </div>

            <p class="text-xs uppercase tracking-wider text-white/70 px-3 mb-3">
                Main Menu
            </p>

            <nav class="flex-1">
                <a href="/Admin/Dashboard" class="sidebar-link">
                    <i class="fa-solid fa-chart-line w-5"></i>
                    <span>Dashboard</span>
                </a>

                <a href="/Admin/Centres" class="sidebar-link active">
                    <i class="fa-solid fa-building w-5"></i>
                    <span>Manage Centres</span>
                </a>

                <a href="/Admin/MasterData" class="sidebar-link">
                    <i class="fa-solid fa-database w-5"></i>
                    <span>Master Data</span>
                </a>
            </nav>

            <div class="border-t border-white/20 pt-5 mt-6">
                <form asp-controller="Auth"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="sidebar-link w-full text-left">
                        <i class="fa-solid fa-right-from-bracket w-5"></i>
                        <span>Sign Out</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content flex-1 min-w-0 p-8">

            <!-- Breadcrumb -->
            <div class="flex flex-wrap items-center gap-2 text-sm mb-5">
                <a href="/Admin/Dashboard"
                   class="text-gray-500 hover:underline">
                    Dashboard
                </a>

                <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>

                <a href="/Admin/Centres"
                   class="text-gray-500 hover:underline">
                    Manage Centres
                </a>

                <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>

                <span class="sage-text font-semibold">Centre Details</span>
            </div>

            <!-- Page Heading -->
            <div class="flex flex-wrap items-center justify-between gap-4 mb-7">

                <div>
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-800">
                        Centre Details
                    </h2>

                    <p class="text-gray-500 text-sm mt-2">
                        View centre information, registered shops and consultants.
                    </p>
                </div>

                <a href="/Admin/Centres"
                   class="sage-button inline-flex items-center gap-2 px-5 py-3 rounded-lg font-semibold text-sm no-underline">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Centres
                </a>
            </div>

            <!-- Centre Information LEFT + Centre Overview RIGHT -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-7">

                <!-- Centre Information: Left side, 2/3 width -->
                <section class="lg:col-span-2 bg-white rounded-2xl shadow-sm overflow-hidden">

                    <div class="sage-heading px-6 py-5 flex items-center gap-3">
                        <div class="w-11 h-11 rounded-xl bg-white/20 flex items-center justify-center">
                            <i class="fa-solid fa-building text-xl"></i>
                        </div>

                        <div>
                            <h3 class="text-lg font-bold">Centre Information</h3>
                            <p class="text-sm text-white/80">
                                Registered centre details
                            </p>
                        </div>
                    </div>

                    <div class="p-6">

                        <div class="mb-6">
                            <p class="text-sm text-gray-500 mb-1">Centre Name</p>
                            <h3 class="text-2xl font-bold text-gray-800">
                                @Model.Name
                            </h3>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                            <!-- Manager -->
                            <div class="info-card">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg sage-soft flex items-center justify-center">
                                        <i class="fa-solid fa-user-tie sage-text"></i>
                                    </div>

                                    <div class="min-w-0">
                                        <p class="text-xs text-gray-500 mb-1">Manager</p>
                                        <p class="font-semibold text-gray-800 break-words">
                                            @(string.IsNullOrWhiteSpace(Model.ContactName)
                                                ? "Not provided"
                                                : Model.ContactName)
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Phone -->
                            <div class="info-card">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg sage-soft flex items-center justify-center">
                                        <i class="fa-solid fa-phone sage-text"></i>
                                    </div>

                                    <div class="min-w-0">
                                        <p class="text-xs text-gray-500 mb-1">Mobile Number</p>
                                        <p class="font-semibold text-gray-800 break-words">
                                            @(string.IsNullOrWhiteSpace(Model.MobileNumber)
                                                ? "Not provided"
                                                : Model.MobileNumber)
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="info-card">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg sage-soft flex items-center justify-center">
                                        <i class="fa-solid fa-envelope sage-text"></i>
                                    </div>

                                    <div class="min-w-0">
                                        <p class="text-xs text-gray-500 mb-1">Email Address</p>
                                        <p class="font-semibold text-gray-800 break-words">
                                            @(string.IsNullOrWhiteSpace(Model.Email)
                                                ? "Not provided"
                                                : Model.Email)
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Address -->
                            <div class="info-card">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg sage-soft flex items-center justify-center">
                                        <i class="fa-solid fa-location-dot sage-text"></i>
                                    </div>

                                    <div class="min-w-0">
                                        <p class="text-xs text-gray-500 mb-1">Address</p>
                                        <p class="font-semibold text-gray-800 break-words">
                                            @(string.IsNullOrWhiteSpace(Model.Address)
                                                ? "Not provided"
                                                : Model.Address)
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="info-card sm:col-span-2">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg sage-soft flex items-center justify-center">
                                        <i class="fa-solid fa-circle-check sage-text"></i>
                                    </div>

                                    <div>
                                        <p class="text-xs text-gray-500 mb-2">Centre Status</p>

                                        @if (Model.IsActive)
                                        {
                                            <span class="status-active">
                                                <i class="fa-solid fa-check mr-1"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-inactive">
                                                <i class="fa-solid fa-ban mr-1"></i>
                                                Inactive
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>

                <!-- Centre Overview: Right side, 1/3 width -->
                <section class="rounded-2xl shadow-sm overflow-hidden self-start"
                         style="background: var(--sage-green); color: white;">

                    <div class="p-6">

                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-11 h-11 rounded-xl bg-white/20 flex items-center justify-center">
                                <i class="fa-solid fa-chart-pie text-xl"></i>
                            </div>

                            <div>
                                <h3 class="text-lg font-bold">Centre Overview</h3>
                                <p class="text-sm text-white/80">
                                    Registration summary
                                </p>
                            </div>
                        </div>

                        <!-- Total Shops -->
                        <div class="rounded-xl p-5 mb-4"
                             style="background: rgba(255,255,255,0.14);">

                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <p class="text-sm text-white/80">Registered Shops</p>
                                    <p class="text-3xl font-bold mt-2">@totalShops</p>
                                </div>

                                <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center">
                                    <i class="fa-solid fa-store text-xl"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Total Consultants -->
                        <div class="rounded-xl p-5"
                             style="background: rgba(255,255,255,0.14);">

                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <p class="text-sm text-white/80">Registered Consultants</p>
                                    <p class="text-3xl font-bold mt-2">@totalConsultants</p>
                                </div>

                                <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center">
                                    <i class="fa-solid fa-users text-xl"></i>
                                </div>
                            </div>
                        </div>

                    </div>
                </section>

            </div>

            <!-- Registered Shops -->
            <section class="bg-white rounded-2xl shadow-sm overflow-hidden mb-7">

                <div class="px-6 py-5 border-b border-gray-100 flex flex-wrap items-center justify-between gap-3">

                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg sage-soft flex items-center justify-center">
                            <i class="fa-solid fa-store sage-text"></i>
                        </div>

                        <div>
                            <h3 class="text-lg font-bold text-gray-800">
                                Registered Shops
                            </h3>
                            <p class="text-sm text-gray-500">
                                Shops associated with this centre
                            </p>
                        </div>
                    </div>

                    <span class="rounded-full px-3 py-1 text-sm font-bold sage-text sage-soft">
                        @totalShops Shops
                    </span>
                </div>

                <div class="table-wrapper">
                    <table class="data-table w-full">

                        <thead class="table-heading">
                            <tr>
                                <th>Shop Name</th>
                                <th>Owner Name</th>
                                <th>GST Number</th>
                                <th>Email</th>
                                <th>Mobile</th>
                                <th>Address</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (shops.Any())
                            {
                                foreach (var shop in shops)
                                {
                                    <tr>
                                        <td class="font-semibold text-gray-800">
                                            @(shop.ShopName ?? "—")
                                        </td>

                                        <td>@(shop.Name ?? "—")</td>

                                        <td>@(shop.GstNumber ?? "—")</td>

                                        <td>@(shop.Email ?? "—")</td>

                                        <td>@(shop.MobileNumber ?? "—")</td>

                                        <td>@(shop.Address ?? "—")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-10">
                                        <div class="flex flex-col items-center gap-3 text-gray-400">
                                            <i class="fa-solid fa-store-slash text-3xl"></i>
                                            <p class="font-medium">
                                                No shops registered for this centre.
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </section>

            <!-- Registered Consultants -->
            <section class="bg-white rounded-2xl shadow-sm overflow-hidden">

                <div class="px-6 py-5 border-b border-gray-100 flex flex-wrap items-center justify-between gap-3">

                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg sage-soft flex items-center justify-center">
                            <i class="fa-solid fa-users sage-text"></i>
                        </div>

                        <div>
                            <h3 class="text-lg font-bold text-gray-800">
                                Registered Consultants
                            </h3>
                            <p class="text-sm text-gray-500">
                                Consultants associated with this centre
                            </p>
                        </div>
                    </div>

                    <span class="rounded-full px-3 py-1 text-sm font-bold sage-text sage-soft">
                        @totalConsultants Consultants
                    </span>
                </div>

                <div class="table-wrapper">
                    <table class="data-table w-full">

                        <thead class="table-heading">
                            <tr>
                                <th>Consultant Name</th>
                                <th>Email</th>
                                <th>Mobile</th>
                                <th>Address</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (consultants.Any())
                            {
                                foreach (var consultant in consultants)
                                {
                                    <tr>
                                        <td class="font-semibold text-gray-800">
                                            @(consultant.Name ?? "—")
                                        </td>

                                        <td>@(consultant.Email ?? "—")</td>

                                        <td>@(consultant.MobileNumber ?? "—")</td>

                                        <td>@(consultant.Address ?? "—")</td>

                                        <td>
                                            @if (consultant.IsActive)
                                            {
                                                <span class="status-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="status-inactive">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-10">
                                        <div class="flex flex-col items-center gap-3 text-gray-400">
                                            <i class="fa-solid fa-user-slash text-3xl"></i>
                                            <p class="font-medium">
                                                No consultants registered for this centre.
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </section>

            <!-- Footer -->
            <footer class="text-center text-sm text-gray-500 mt-8">
                © @DateTime.Now.Year GSTIntel Admin Portal. All rights reserved.
            </footer>

        </main>
    </div>
</body>
</html>