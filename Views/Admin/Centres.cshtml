@model IEnumerable<GSTFiling.Models.Centre>

@{
    Layout = null;
    ViewData["Title"] = "Centre Administration";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Centre Administration - GSTIntel</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --sage-green: #1B5E20;
            --sage-dark: #0D3B12;
            --sage-light: #EAF5E8;
        }

        body {
            font-family: Arial, sans-serif;
            background: #EAF5E8;
        }

        /* Sidebar */
        .sidebar {
            background: var(--sage-green);
            min-height: 100vh;
        }

        /* Sidebar navigation */
        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 8px;
            color: #EAF5E8;
            text-decoration: none;
            transition: .2s;
        }

        .nav-link:hover,
        .nav-link.active {
            background: var(--sage-dark);
            color: white;
        }

        /* Form fields */
        .form-field {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 10px 12px;
            outline: none;
            background: white;
        }

        .form-field:focus {
            border-color: var(--sage-green);
            box-shadow: 0 0 0 2px rgba(27, 94, 32, .15);
        }

        /* Modal backdrop */
        .modal-backdrop {
            background: rgba(0, 0, 0, .55);
        }

        /* Dark green buttons */
        .sage-button {
            background: var(--sage-green);
            color: white;
            transition: .2s;
        }

        .sage-button:hover {
            background: var(--sage-dark);
            color: white;
        }

        /* Green links and icons */
        .sage-text {
            color: var(--sage-green);
        }

        .sage-text:hover {
            color: var(--sage-dark);
        }

        /* Modal header */
        .sage-modal-header {
            background: var(--sage-green);
            color: white;
        }

        /* Table header */
        .table-header {
            background: var(--sage-light);
        }

        /* Edit icon */
        .edit-button {
            color: var(--sage-green);
            transition: .2s;
        }

        .edit-button:hover {
            color: var(--sage-dark);
        }

        /* Password eye */
        .password-eye {
            color: var(--sage-green);
        }

        .password-eye:hover {
            color: var(--sage-dark);
        }

        /* Main heading */
        .page-heading {
            color: var(--sage-dark);
        }

        /* Table row hover */
        .centre-row:hover {
            background: #F1F7F0;
        }
    </style>
</head>

<body>
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="sidebar w-64 p-5 text-white shrink-0 hidden md:block">

            <div class="mb-10">
                <h1 class="text-2xl font-bold">
                    <i class="fa-solid fa-leaf mr-2"></i>GSTIntel
                </h1>

                <p class="text-emerald-100 text-sm mt-1">
                    Administration Portal
                </p>
            </div>

            <nav class="space-y-2">

                <a href="/Admin/Dashboard" class="nav-link">
                    <i class="fa-solid fa-gauge-high w-5"></i>
                    Dashboard
                </a>

                <a href="/Admin/Centres" class="nav-link active">
                    <i class="fa-solid fa-building w-5"></i>
                    Manage Centres
                </a>

                <a href="/Admin/MasterData" class="nav-link">
                    <i class="fa-solid fa-database w-5"></i>
                    Master Data
                </a>

            </nav>

            <div class="mt-10">
                <form method="post" action="/Auth/Logout">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="nav-link w-full text-left">

                        <i class="fa-solid fa-right-from-bracket w-5"></i>
                        Sign Out
                    </button>
                </form>
            </div>

        </aside>

        <!-- Main Content -->
        <main class="flex-1 min-w-0 p-5 md:p-8">

            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-center
                sm:justify-between gap-4 mb-8">

                <div>
                    <h2 class="text-2xl md:text-3xl font-bold page-heading">
                        Centre Administration
                    </h2>

                    <p class="text-gray-500 mt-2">
                        Manage and update your registered centres.
                    </p>
                </div>

                <a href="/Admin/RegisterCentre"
                   class="sage-button inline-flex items-center justify-center
                    gap-2 px-5 py-3 rounded-lg font-semibold">

                    <i class="fa-solid fa-plus"></i>
                    Register New Centre
                </a>

            </div>

            <!-- Success Message -->
            @if (TempData["Success"] != null)
            {
                <div class="mb-5 rounded-lg border border-green-200
                    bg-green-50 text-green-800 p-4">

                    <i class="fa-solid fa-circle-check mr-2"></i>
                    @TempData["Success"]
                </div>
            }

            <!-- Error Message -->
            @if (TempData["Error"] != null)
            {
                <div class="mb-5 rounded-lg border border-red-200
                    bg-red-50 text-red-800 p-4">

                    <i class="fa-solid fa-circle-exclamation mr-2"></i>
                    @TempData["Error"]
                </div>
            }

            <!-- Centres Table -->
            <div class="bg-white rounded-xl shadow-sm
                border border-gray-200 overflow-hidden">

                <div class="p-5 border-b border-gray-200">
                    <h3 class="text-lg font-bold page-heading">
                        Registered Centres
                    </h3>

                    <p class="text-sm text-gray-500 mt-1">
                        Total centres: @(Model?.Count() ?? 0)
                    </p>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">

                        <thead class="table-header text-gray-700 uppercase">
                            <tr>
                                <th class="px-5 py-4">Centre Details</th>
                                <th class="px-5 py-4">Contact</th>
                                <th class="px-5 py-4">Current Tax</th>
                                <th class="px-5 py-4">Status</th>
                                <th class="px-5 py-4 text-right">Actions</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-gray-100">

                            @if (Model != null && Model.Any())
                            {
                                foreach (var centre in Model)
                                {
                                    <tr class="centre-row">

                                        <!-- Centre Details -->
                                        <td class="px-5 py-4">
                                            <div class="font-semibold text-gray-800">
                                                @centre.Name
                                            </div>

                                            <div class="text-gray-500 text-xs mt-1">
                                                ID: @centre.Id
                                            </div>

                                            <div class="text-gray-500 text-xs mt-1">
                                                @centre.Address
                                            </div>
                                        </td>

                                        <!-- Contact -->
                                        <td class="px-5 py-4">
                                            <div class="font-medium text-gray-700">
                                                @centre.ContactName
                                            </div>

                                            <div class="text-gray-500 mt-1">
                                                @centre.Email
                                            </div>

                                            <div class="text-gray-500 mt-1">
                                                @centre.MobileNumber
                                            </div>
                                        </td>

                                        <!-- Current Tax -->
                                        <td class="px-5 py-4 text-gray-500">
                                            Not available
                                        </td>

                                        <!-- Status -->
                                        <td class="px-5 py-4">

                                            @if (centre.IsActive)
                                            {
                                                <span class="inline-flex rounded-full
                                                    bg-green-100 text-green-800
                                                    px-3 py-1 text-xs font-semibold">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex rounded-full
                                                    bg-red-100 text-red-800
                                                    px-3 py-1 text-xs font-semibold">
                                                    Inactive
                                                </span>
                                            }

                                            <form method="post"
                                                  action="/Admin/ToggleStatus"
                                                  class="mt-2">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@centre.Id" />

                                                <button type="submit"
                                                        class="sage-text text-xs font-semibold">

                                                    Change Status
                                                </button>
                                            </form>

                                        </td>

                                        <!-- Actions -->
                                        <td class="px-5 py-4">
                                            <div class="flex items-center
                                                justify-end gap-4">

                                                <!-- View Centre Details -->
                                                <a asp-controller="Admin"
                                                   asp-action="ViewCentre"
                                                   asp-route-id="@centre.Id"
                                                   title="View Centre Details"
                                                   class="sage-text">

                                                    <i class="fa-solid fa-eye text-lg"></i>
                                                </a>

                                                <!-- Edit Centre -->
                                                <button type="button"
                                                        title="Edit Centre"
                                                        onclick="openEditModal(this)"
                                                        data-id="@centre.Id"
                                                        data-name="@centre.Name"
                                                        data-address="@centre.Address"
                                                        data-email="@centre.Email"
                                                        data-manager="@centre.ContactName"
                                                        data-mobile="@centre.MobileNumber"
                                                        class="edit-button">

                                                    <i class="fa-solid fa-pen-to-square text-lg"></i>
                                                </button>

                                                <!-- Delete Centre -->
                                                <form method="post"
                                                      action="/Admin/DeleteCentre"
                                                      onsubmit="return confirm('Are you sure you want to delete this centre?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@centre.Id" />

                                                    <button type="submit"
                                                            title="Delete Centre"
                                                            class="text-red-600 hover:text-red-800">

                                                        <i class="fa-solid fa-trash text-lg"></i>
                                                    </button>
                                                </form>

                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5"
                                        class="px-5 py-12 text-center text-gray-500">

                                        <i class="fa-solid fa-building text-3xl mb-3"></i>

                                        <p>No centres found.</p>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <!-- Edit Centre Modal -->
    <div id="editCentreModal"
         class="fixed inset-0 z-50 hidden items-center
        justify-center modal-backdrop p-4">

        <div class="bg-white rounded-2xl shadow-2xl w-full
            max-w-2xl max-h-[90vh] overflow-y-auto">

            <!-- Modal Header -->
            <div class="sage-modal-header p-5
                flex items-center justify-between sticky top-0">

                <div>
                    <h3 class="text-xl font-bold">
                        Edit Centre Profile
                    </h3>

                    <p class="text-green-50 text-sm mt-1">
                        Update the selected centre details.
                    </p>
                </div>

                <button type="button"
                        onclick="closeEditModal()"
                        class="text-white hover:text-green-100 text-2xl"
                        aria-label="Close">

                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Edit Form -->
            <form method="post"
                  action="/Admin/EditCentre"
                  id="editCentreForm">

                @Html.AntiForgeryToken()

                <input type="hidden" name="Id" id="editId" />

                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- Centre Name -->
                    <div>
                        <label for="editName"
                               class="block text-sm font-semibold
                            text-gray-700 mb-2">
                            Centre Name
                        </label>

                        <input type="text"
                               name="Name"
                               id="editName"
                               class="form-field"
                               required />
                    </div>

                    <!-- Address -->
                    <div>
                        <label for="editAddress"
                               class="block text-sm font-semibold
                            text-gray-700 mb-2">
                            Address
                        </label>

                        <input type="text"
                               name="Address"
                               id="editAddress"
                               class="form-field" />
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="editEmail"
                               class="block text-sm font-semibold
                            text-gray-700 mb-2">
                            Email
                        </label>

                        <input type="email"
                               name="Email"
                               id="editEmail"
                               class="form-field" />
                    </div>

                    <!-- Password -->
                    <div>
                        <label for="editPassword"
                               class="block text-sm font-semibold
                            text-gray-700 mb-2">
                            New Password
                        </label>

                        <div class="relative">
                            <input type="password"
                                   name="NewPassword"
                                   id="editPassword"
                                   class="form-field pr-12"
                                   placeholder="Leave blank to keep unchanged"
                                   autocomplete="new-password" />

                            <button type="button"
                                    onclick="togglePasswordVisibility()"
                                    class="password-eye absolute right-3 top-1/2
                                -translate-y-1/2"
                                    aria-label="Show or hide password">

                                <i id="passwordEyeIcon"
                                   class="fa-solid fa-eye"></i>
                            </button>
                        </div>

                        <p class="text-xs text-gray-500 mt-1">
                            Leave blank to keep the current password.
                        </p>
                    </div>

                    <!-- Manager -->
                    <div>
                        <label for="editManager"
                               class="block text-sm font-semibold
                            text-gray-700 mb-2">
                            Manager
                        </label>

                        <input type="text"
                               name="ContactName"
                               id="editManager"
                               class="form-field" />
                    </div>

                    <!-- Mobile -->
                    <div>
                        <label for="editMobile"
                               class="block text-sm font-semibold
                            text-gray-700 mb-2">
                            Mobile
                        </label>

                        <input type="tel"
                               name="MobileNumber"
                               id="editMobile"
                               class="form-field" />
                    </div>

                </div>

                <!-- Modal Footer -->
                <div class="px-6 pb-6 flex justify-end gap-3">

                    <button type="button"
                            onclick="closeEditModal()"
                            class="px-5 py-2.5 rounded-lg border
                        border-gray-300 text-gray-700
                        hover:bg-gray-100 font-semibold">

                        Cancel
                    </button>

                    <button type="submit"
                            class="sage-button px-5 py-2.5 rounded-lg
                        font-semibold">

                        <i class="fa-solid fa-floppy-disk mr-2"></i>
                        Save Changes
                    </button>

                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript -->
    <script>
        function openEditModal(button) {
            document.getElementById('editId').value =
                button.dataset.id || '';

            document.getElementById('editName').value =
                button.dataset.name || '';

            document.getElementById('editAddress').value =
                button.dataset.address || '';

            document.getElementById('editEmail').value =
                button.dataset.email || '';

            document.getElementById('editManager').value =
                button.dataset.manager || '';

            document.getElementById('editMobile').value =
                button.dataset.mobile || '';

            document.getElementById('editPassword').value = '';
            document.getElementById('editPassword').type = 'password';

            document.getElementById('passwordEyeIcon').className =
                'fa-solid fa-eye';

            const modal = document.getElementById('editCentreModal');

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeEditModal() {
            const modal = document.getElementById('editCentreModal');

            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function togglePasswordVisibility() {
            const passwordInput =
                document.getElementById('editPassword');

            const eyeIcon =
                document.getElementById('passwordEyeIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeEditModal();
            }
        });

        const editModal =
            document.getElementById('editCentreModal');

        editModal.addEventListener('click', function (event) {
            if (event.target === this) {
                closeEditModal();
            }
        });
    </script>

</body>
</html>