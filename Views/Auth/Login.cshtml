@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>GSTIntel Login</title>

    <style>
            body {
                background-color: #1e5e3a;
                font-family: Arial;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                margin: 0;
            }

            .login-box {
                background-color: white;
                width: 320px;
                padding: 30px;
                border-radius: 10px;
                text-align: center;
            }

            h2 {
                color: #2e7d32;
            }

            p {
                color: gray;
            }

            label {
                display: block;
                text-align: left;
                margin-top: 15px;
            }

            input {
                width: 100%;
                padding: 10px;
                margin-top: 5px;
                box-sizing: border-box;
                border: 1px solid #ccc;
                border-radius: 5px;
            }

            button {
                width: 100%;
                padding: 10px;
                margin-top: 20px;
                background-color: #2e7d32;
                color: white;
                border: none;
                border-radius: 5px;
                cursor: pointer;
            }

                button:hover {
                    background-color: #215d25;
                }

            .error {
                color: red;
                text-align: left;
                font-size: 13px;
                margin-top: 5px;
            }
    </style>
</head>

<body>

    <div class="login-box">

        <h2>GSTIntel</h2>
        <p>Sign in to access your portal</p>

        <form method="post" action="/Auth/Login">
    @Html.AntiForgeryToken()

    <label>Email Address</label>
    <input type="email"
           name="username"
           placeholder="Enter your email"
           required />

    @if (ViewBag.EmailError != null)
    {
        <div class="error">@ViewBag.EmailError</div>
    }

    <label>Password</label>
    <input type="password"
           name="password"
           placeholder="Enter password"
           required />

    @if (ViewBag.PasswordError != null)
    {
        <div class="error">@ViewBag.PasswordError</div>
    }

    <button type="submit">Sign In</button>
</form>

        <p>GST Management System</p>

    </div>

</body>
</html>
