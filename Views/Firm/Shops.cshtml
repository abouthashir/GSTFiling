@model ShopsPageViewModel
@{
    ViewData["Title"] = "Shops";

    var filters = new[]
    {
        (Value: "all", Text: "All"),
        (Value: "assigned", Text: "Assigned"),
        (Value: "unassigned", Text: "Not assigned")
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 fw-bold text-success mb-1">Shops</h1>
        <p class="text-muted mb-0">@Model.Shops.Count shop(s) shown</p>
    </div>
    <a class="btn btn-success" asp-action="AddShop">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Add shop
    </a>
</div>

<nav class="mb-3" aria-label="Filter shops">
    <div class="btn-group" role="group">
        @foreach (var f in filters)
        {
            bool isCurrent = Model.Filter == f.Value;
            <a class="btn btn-sm @(isCurrent ? "btn-success" : "btn-outline-success")"
               asp-action="Shops" asp-route-filter="@f.Value"
               aria-current="@(isCurrent ? "page" : null)">@f.Text</a>
        }
    </div>
</nav>

@if (Model.Shops.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-shop display-4 text-muted" aria-hidden="true"></i>
            @if (Model.Filter == "all")
            {
                <p class="mt-3 mb-3">No shops yet.</p>
                <a class="btn btn-success" asp-action="AddShop">Add your first shop</a>
            }
            else
            {
                <p class="mt-3 mb-0">No shops match this filter.</p>
            }
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Shop</th>
                        <th scope="col">Owner</th>
                        <th scope="col">Email</th>
                        <th scope="col">Consultant</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                                <tbody>
                    @foreach (var shop in Model.Shops)
                    {
                        string? currentId = shop.ConsultantId?.ToString();
                        bool currentIsInactive = currentId != null && !Model.ConsultantOptions.Any(o => o.Value == currentId);

                        <tr>
                            <td>
                                <div class="fw-semibold">@shop.ShopName</div>
                                <div class="small text-muted">GST: @shop.GstNumber</div>
                            </td>
                            <td>
                                <div>@shop.OwnerName</div>
                                <div class="small text-muted">@shop.MobileNumber</div>
                            </td>
                            <td>@shop.Email</td>
                            <td>
                                <form method="post" asp-action="AssignConsultant" class="d-flex gap-1">
                                    <input type="hidden" name="shopId" value="@shop.Id" />
                                    <input type="hidden" name="returnFilter" value="@Model.Filter" />
                                    <label class="visually-hidden" for="consultant-@shop.Id">Consultant for @shop.ShopName</label>
                                    <select id="consultant-@shop.Id" name="consultantId"
                                            class="form-select form-select-sm @(currentId == null ? "border-warning" : "")">
                                        <option value="">— Not assigned —</option>
                                        @foreach (var option in Model.ConsultantOptions)
                                        {
                                            <option value="@option.Value" selected="@(option.Value == currentId)">@option.Text</option>
                                        }
                                        @if (currentIsInactive)
                                        {
                                            <option value="@currentId" selected>@shop.ConsultantName (inactive)</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-success" aria-label="Save consultant for @shop.ShopName">Assign</button>
                                </form>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="ShopInvoices" asp-route-id="@shop.Id"
                                       aria-label="View invoices of @shop.ShopName">
                                        <i class="bi bi-receipt" aria-hidden="true"></i> Invoices
                                    </a>
                                    <a class="btn btn-sm btn-outline-success" asp-action="EditShop" asp-route-id="@shop.Id"
                                       aria-label="Edit @shop.ShopName">
                                        <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                    </a>
                                    <form method="post" asp-action="DeleteShop" asp-route-id="@shop.Id"
                                          data-confirm="Delete @shop.ShopName and its login? This cannot be undone."
                                          onsubmit="return confirm(this.dataset.confirm);">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete @shop.ShopName">
                                            <i class="bi bi-trash" aria-hidden="true"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}