@model List<Consultant>
@{
    ViewData["Title"] = "Consultants";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold text-success mb-1">Consultants</h1>
        <p class="text-muted mb-0">@Model.Count consultant(s) in your centre</p>
    </div>
    <a class="btn btn-success" asp-action="AddConsultant">
        <i class="bi bi-person-plus" aria-hidden="true"></i> Add consultant
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-people display-4 text-muted" aria-hidden="true"></i>
            <p class="mt-3 mb-3">No consultants yet.</p>
            <a class="btn btn-success" asp-action="AddConsultant">Add your first consultant</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Mobile</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var consultant in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@consultant.Name</td>
                            <td>@consultant.Email</td>
                            <td>@consultant.MobileNumber</td>
                            <td>
                                @if (consultant.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-success" asp-action="EditConsultant" asp-route-id="@consultant.Id"
                                   aria-label="Edit @consultant.Name">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}